programa
{
    funcao inicio()
    {
        cadeia nomePai
        cadeia nomeMae

        escreva("Digite o nome do seu pai: ")
        leia(nomePai)

        escreva("Digite o nome da sua mae: ")
        leia(nomeMae)

        escreva("\nNome do pai: ", nomePai)
        escreva("\nNome da mae: ", nomeMae)
    }
}