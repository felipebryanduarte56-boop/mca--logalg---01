programa
{
    funcao inicio()
    {
        cadeia disciplina
        inteiro ano

        escreva("Digite o nome da disciplina: ")
        leia(disciplina)

        escreva("Digite o ano que voce esta cursando: ")
        leia(ano)

        escreva("\nDisciplina: ", disciplina)
        escreva("\nAno: ", ano)
    }
}
